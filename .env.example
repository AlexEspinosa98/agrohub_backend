# Copia este archivo a .env y completa los valores reales.
# docker-compose lo carga automáticamente para el servicio `app`.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*

# Base de datos MySQL — en docker-compose el host real es "db" (se fuerza en
# el propio compose); estos valores rellenan el usuario/clave/nombre de la
# base y también sirven si corres Django fuera de Docker contra un MySQL local.
DB_HOST=db
DB_PORT=3306
DB_NAME=agrohub
DB_USER=agrohub
DB_PASSWORD=agrohub
DB_ROOT_PASSWORD=changeme

# Bootstrap del primer superadmin (header X-Superadmin-Token)
SUPERADMIN_TOKEN=

# Chat IA (Gemini)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Correo transaccional (OTP de recuperación de contraseña)
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_P=
MAIL_SECURE=true
MAIL_FROM=
MAIL_FROM_NAME=AgroHub

# WhatsApp (Meta Business API), opcional
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Transcripción de audio (Whisper), opcional y pesada — desactivada por defecto
ENABLE_TRANSCRIBE=false
